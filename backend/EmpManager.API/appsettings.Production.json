// ═══════════════════════════════════════════════════════════════
// FILE: appsettings.Production.json
// PURPOSE: Production environment — NO secrets stored here.
//          Real values MUST come from environment variables or a secrets manager.
//
// HOW TO PROVIDE SECRETS IN PRODUCTION:
//
// Option 1: Environment Variables (simplest)
//   Export before running:
//     export Jwt__SecretKey="<strong-256bit-key>"
//     export AdminUser__Username="<prod-username>"
//     export AdminUser__Password="<strong-password>"
//
// Option 2: Azure Key Vault
//   builder.Configuration.AddAzureKeyVault(...)
//
// Option 3: AWS Secrets Manager
//   builder.Configuration.AddSecretsManager(...)
//
// Option 4: Docker / Kubernetes secrets
//   --secret or secretKeyRef in pod spec
//
// INTERVIEW QUESTION:
// Q: How do you handle secrets in a CI/CD pipeline?
// A: Store secrets in the CI/CD platform's secret store (GitHub Actions Secrets,
//    Azure DevOps Variable Groups, GitLab CI Variables). Inject them as environment
//    variables at deploy time. The application reads them via configuration.
//    NEVER put secrets in the repository — not even encrypted.
// ═══════════════════════════════════════════════════════════════
{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Error"
    }
  },
  "Jwt": {
    "SecretKey": "",
    "ExpiryHours": 8
  },
  "AdminUser": {
    "Username": "",
    "Password": "",
    "Role": "Admin"
  },
  "AllowedOrigins": [
    "https://yourproductionapp.com"
  ]
}
